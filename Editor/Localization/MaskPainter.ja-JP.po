msgid ""
msgstr ""
"Language: ja-JP\n"
"Content-Type: text/plain; charset=UTF-8\n"
"X-DocMe-Reviewed: no\n"

#. en: Mask Painter
msgid "window.title"
msgstr "Mask Painter"

#. en: Mask Painter*
msgid "window.title.unsaved"
msgstr "Mask Painter*"

#. en: Paint where an effect shows: white shows it, black hides it. The mask follows the mesh's UV map, so it fits any texture slot of the material it is for.
msgid "intro.text"
msgstr "エフェクトを表示したい場所を塗ります。白は表示、黒は非表示です。マスクはメッシュのUVマップに沿うので、対象マテリアルのどのテクスチャスロットにも使えます。"

#. en: Mesh
msgid "section.mesh"
msgstr "メッシュ"

#. en: Save
msgid "section.save"
msgstr "保存"

#. en: Mesh
msgid "field.mesh"
msgstr "メッシュ"

#. en: The mesh to paint on, from your avatar in the scene.
msgid "field.mesh.tip"
msgstr "塗る対象のメッシュです。シーン内のアバターから選びます。"

#. en: Material
msgid "field.material"
msgstr "マテリアル"

#. en: The material the mask is for: only the part of the mesh it covers is painted.
msgid "field.material.tip"
msgstr "マスクを使うマテリアルです。メッシュのうち、そのマテリアルが使われている部分だけを塗ります。"

#. en: UV map
msgid "field.uv"
msgstr "UVマップ"

#. en: Which of the mesh's UV maps the mask follows: most Poiyomi masks use UV0.
msgid "field.uv.tip"
msgstr "マスクが沿うUVマップです。Poiyomiのマスクはほとんどの場合UV0を使います。"

#. en: Black
msgid "start.black"
msgstr "黒"

#. en: White
msgid "start.white"
msgstr "白"

#. en: Texture
msgid "field.texture"
msgstr "テクスチャ"

#. en: A texture to keep painting on; the tool finds the mesh and material that use it.
msgid "field.texture.tip"
msgstr "続きを塗るテクスチャです。使っているメッシュとマテリアルは自動で見つけます。"

#. en: Size
msgid "field.size"
msgstr "サイズ"

#. en: How many pixels wide and high the new mask is.
msgid "field.size.tip"
msgstr "新しいマスクの縦と横のピクセル数です。"

#. en: Start painting
msgid "button.start"
msgstr "ペイントを始める"

#. en: Start over
msgid "button.startover"
msgstr "最初からやり直す"

#. en: Starts a new mask with these settings.
msgid "button.start.tip"
msgstr "この設定で新しいマスクを始めます。"

#. en: (empty)
msgid "material.empty"
msgstr "(なし)"

#. en: Pick a mesh from your avatar in the scene, or select it before opening this window.
msgid "mesh.pick"
msgstr "シーン内のアバターからメッシュを選ぶか、このウィンドウを開く前にメッシュを選択してください。"

#. en: This object has no mesh to paint on.
msgid "mesh.none"
msgstr "このオブジェクトには塗れるメッシュがありません。"

#. en: This mesh has nothing on {0}: pick another UV map.
msgid "mesh.nouv"
msgstr "このメッシュには{0}のデータがありません。別のUVマップを選んでください。"

#. en: This texture is larger than {0} pixels: pick a smaller one.
msgid "mesh.toolarge"
msgstr "このテクスチャは{0}ピクセルより大きいため使えません。小さいものを選んでください。"

#. en: The mesh you were painting on is gone: Ctrl+Z brings it back. You can still save the mask.
msgid "mesh.gone"
msgstr "塗っていたメッシュが見つかりません。Ctrl+Zで元に戻せます。マスクの保存はできます。"

#. en: {0}: 1 piece on {2}, {3} x {4} pixels.
msgid "mesh.describe.one"
msgstr "{0}: {2}に1個のパーツ、{3} x {4}ピクセル。"

#. en: {0}: {1} pieces on {2}, {3} x {4} pixels.
msgid "mesh.describe.many"
msgstr "{0}: {2}に{1}個のパーツ、{3} x {4}ピクセル。"

#. en: Select
msgid "tool.off"
msgstr "選択"

#. en: Clicks in the Scene view select objects as usual.
msgid "tool.off.tip"
msgstr "シーンビューのクリックで、いつも通りオブジェクトを選択します。"

#. en: Fill pieces
msgid "tool.fill"
msgstr "パーツ塗り"

#. en: A click fills the whole piece of the model under the mouse (G).
msgid "tool.fill.tip"
msgstr "クリックすると、マウス下にあるモデルのパーツ全体を塗ります（G）。"

#. en: Brush
msgid "tool.brush"
msgstr "ブラシ"

#. en: Drag on the model to paint with a round brush (B).
msgid "tool.brush.tip"
msgstr "モデル上をドラッグして、丸いブラシで塗ります（B）。"

#. en: Brush size (cm)
msgid "field.brush"
msgstr "ブラシ幅 (cm)"

#. en: How wide the brush is on the model, in centimetres; [ and ] or Ctrl+mouse wheel change it too.
msgid "field.brush.tip"
msgstr "モデル上のブラシの幅をセンチメートルで指定します。[ と ] キー、Ctrl+マウスホイールでも変えられます。"

#. en: Softness
msgid "field.softness"
msgstr "ぼかし"

#. en: How gently the brush fades at its edge, from a hard edge at 0 to fully soft at 1.
msgid "field.softness.tip"
msgstr "ブラシの縁のぼけ具合です。0で縁がはっきり、1で完全にやわらかくなります。"

#. en: Strength
msgid "field.strength"
msgstr "強さ"

#. en: How far one fill or stroke moves the mask toward white or black, so low values build it up over several strokes.
msgid "field.strength.tip"
msgstr "1回の塗りつぶしやストロークでマスクを白または黒へどれだけ近づけるかで、小さい値では何度も塗って少しずつ重ねられます。"

#. en: Mirror
msgid "field.mirror"
msgstr "ミラー"

#. en: Paints and fills the same on the other side of the avatar, left and right.
msgid "field.mirror.tip"
msgstr "アバターの左右反対側にも同じように塗ります。"

#. en: Click a piece of the model to fill it, Shift+click for the other colour. Ctrl+click picks the grey under the mouse.
msgid "hint.fill"
msgstr "モデルのパーツをクリックで塗り、Shift+クリックでもう一方の色になります。Ctrl+クリックでマウス下のグレーを拾います。"

#. en: Drag on the model to paint, hold Shift for the other colour. Ctrl+click picks the grey under the mouse, and Alt+drag still turns the view.
msgid "hint.brush"
msgstr "モデル上をドラッグで塗り、Shiftを押すともう一方の色になります。Ctrl+クリックでマウス下のグレーを拾い、Alt+ドラッグで視点を回せます。"

#. en: Pick Fill pieces, Brush or Smooth to paint in the Scene view.
msgid "hint.off"
msgstr "パーツ塗り、ブラシ、ぼかしのどれかを選ぶと、シーンビューで塗れます。"

#. en: To paint under clothes, hide them with the eye icon in the Hierarchy: it hides them only in the Scene view.
msgid "hint.clothes"
msgstr "服の下を塗るには、ヒエラルキーの目のアイコンで服を隠します。隠れるのはシーンビューだけです。"

#. en: Whole mask
msgid "row.whole"
msgstr "マスク全体"

#. en: Changes the whole mask at once; Ctrl+Z takes it back.
msgid "row.whole.tip"
msgstr "マスク全体を一度に変えます。Ctrl+Zで元に戻せます。"

#. en: All black
msgid "button.allblack"
msgstr "すべて黒"

#. en: Makes the whole mask black.
msgid "button.allblack.tip"
msgstr "マスク全体を黒にします。"

#. en: All white
msgid "button.allwhite"
msgstr "すべて白"

#. en: Makes the whole mask white.
msgid "button.allwhite.tip"
msgstr "マスク全体を白にします。"

#. en: Invert
msgid "button.invert"
msgstr "反転"

#. en: Swaps black and white everywhere.
msgid "button.invert.tip"
msgstr "白と黒をすべて入れ替えます。"

#. en: Show
msgid "field.show"
msgstr "表示"

#. en: What the Scene view draws over the model: one channel or every channel in its own colour, the mask's greys, or nothing.
msgid "field.show.tip"
msgstr "シーンビューでモデルに重ねる表示です。チャンネルごとの色、マスクのグレー、何も出さない、から選べます。"

#. en: This channel
msgid "show.overlay"
msgstr "このチャンネル"

#. en: Mask only
msgid "show.mask"
msgstr "マスクのみ"

#. en: Nothing
msgid "show.nothing"
msgstr "表示しない"

#. en: Not saved yet.
msgid "saved.none"
msgstr "まだ保存されていません。"

#. en: Changes not saved yet: {0}
msgid "saved.unsaved"
msgstr "未保存の変更があります: {0}"

#. en: Saved: {0}
msgid "saved.saved"
msgstr "保存済み: {0}"

#. en: Mask file
msgid "row.file"
msgstr "マスクファイル"

#. en: Saves the mask as a PNG laid out like the mesh's UV map.
msgid "row.file.tip"
msgstr "メッシュのUVマップと同じ配置のPNGとして、マスクを保存します。"

#. en: Save
msgid "button.save"
msgstr "保存"

#. en: Writes the changes into the PNG it was saved to last.
msgid "button.save.tip"
msgstr "最後に保存したPNGに変更を書き込みます。"

#. en: Save as...
msgid "button.saveas"
msgstr "名前を付けて保存..."

#. en: Saves the mask as a new PNG in your project.
msgid "button.saveas.tip"
msgstr "マスクをプロジェクト内の新しいPNGとして保存します。"

#. en: Slot
msgid "row.slot"
msgstr "スロット"

#. en: Which texture slot of the material gets the mask.
msgid "row.slot.tip"
msgstr "マテリアルのどのテクスチャスロットにマスクを入れるかを選びます。"

#. en: Pick a slot
msgid "button.pickslot"
msgstr "スロットを選ぶ"

#. en: Opens a searchable list of the material's texture slots, mask slots first.
msgid "button.pickslot.tip"
msgstr "マテリアルのテクスチャスロットを検索できる一覧を開きます。マスク用のスロットが先に並びます。"

#. en: {0}: click to pick another slot.
msgid "button.pickslot.picked"
msgstr "{0}: クリックして別のスロットを選べます。"

#. en: This material is inside the model file and cannot keep changes: extract it to its own file first.
msgid "note.embedded"
msgstr "このマテリアルはモデルファイルの中にあるため、変更を保存できません。先にマテリアルを個別のファイルに取り出してください。"

#. en: This material has no texture slot.
msgid "note.noslots"
msgstr "このマテリアルにはテクスチャスロットがありません。"

#. en: This material is locked and this slot was empty when it was locked, so Poiyomi may ignore the mask until you unlock the material and lock it again.
msgid "note.lockedempty"
msgstr "このマテリアルはロックされていて、ロックしたときこのスロットは空でした。マテリアルのロックを解除してもう一度ロックするまで、Poiyomiがマスクを無視することがあります。"

#. en: This material is locked, so Poiyomi hides the slots of features that are off: unlock it to see them all.
msgid "note.locked"
msgstr "このマテリアルはロックされているため、Poiyomiはオフの機能のスロットを隠しています。すべて見るにはロックを解除してください。"

#. en: Put into material
msgid "button.put"
msgstr "マテリアルに入れる"

#. en: Saves the mask if needed and puts it into the chosen slot; Ctrl+Z takes it out again.
msgid "button.put.tip"
msgstr "必要ならマスクを保存し、選んだスロットに入れます。Ctrl+Zで取り出せます。"

#. en: Saved {0} as {1}.
msgid "status.saved"
msgstr "{0}に{1}で保存しました。"

#. en: Put into {0}: {1}.
msgid "status.put"
msgstr "{0}に入れました: {1}。"

#. en: Save mask
msgid "dialog.save.title"
msgstr "マスクを保存"

#. en: Where to save the mask in your project.
msgid "dialog.save.message"
msgstr "マスクをプロジェクト内のどこに保存するかを選んでください。"

#. en: Start a new mask?
msgid "dialog.new.title"
msgstr "新しいマスクを始めますか?"

#. en: The mask you are painting has changes that are not saved. Start a new one anyway?
msgid "dialog.new.message"
msgstr "いま塗っているマスクに未保存の変更があります。それでも新しく始めますか?"

#. en: Start new
msgid "dialog.new.ok"
msgstr "新しく始める"

#. en: Cancel
msgid "dialog.cancel"
msgstr "キャンセル"

#. en: The mask you painted on {0} has changes that are not saved. Save them before quitting?
msgid "quit.message"
msgstr "{0}に塗ったマスクに未保存の変更があります。終了する前に保存しますか?"

#. en: your mesh
msgid "quit.mesh"
msgstr "メッシュ"

#. en: Save
msgid "quit.save"
msgstr "保存"

#. en: Quit without saving
msgid "quit.discard"
msgstr "保存せずに終了"

#. en: Texture slots
msgid "picker.title"
msgstr "テクスチャスロット"

#. en: Fill mask piece
msgid "undo.fillpiece"
msgstr "マスクのパーツを塗る"

#. en: Fill mask white
msgid "undo.fillwhite"
msgstr "マスクを白で塗る"

#. en: Fill mask black
msgid "undo.fillblack"
msgstr "マスクを黒で塗る"

#. en: Invert mask
msgid "undo.invert"
msgstr "マスクを反転"

#. en: Paint mask
msgid "undo.paint"
msgstr "マスクを塗る"

#. en: Put mask into {0}
msgid "undo.put"
msgstr "マスクを{0}に入れる"

#. en: The language of this window. Modular Avatar and other tools that use NDMF share this choice.
msgid "field.language.tip"
msgstr "このウィンドウの表示言語です。Modular Avatar など NDMF を使うツールと同じ設定を共有します。"

#. en: From the material
msgid "button.fromslot"
msgstr "マテリアルから"

#. en: Opens the texture in one of the material's slots and remembers the slot for Put into material.
msgid "button.fromslot.tip"
msgstr "マテリアルのスロットにあるテクスチャを開き、そのスロットを「マテリアルに入れる」用に覚えておきます。"

#. en: {0} holds no texture to start from.
msgid "status.slotempty"
msgstr "{0}には始めるためのテクスチャがありません。"

#. en: Paint into
msgid "field.channel"
msgstr "塗るチャンネル"

#. en: Which colour channel of the mask you paint, for shaders that read a different mask from each one.
msgid "field.channel.tip"
msgstr "チャンネルごとに別のマスクを読むシェーダーのために、マスクのどの色チャンネルを塗るかを選びます。"

#. en: All channels (grey)
msgid "channel.all"
msgstr "すべてのチャンネル（グレー）"

#. en: Red
msgid "channel.red"
msgstr "赤"

#. en: Green
msgid "channel.green"
msgstr "緑"

#. en: Blue
msgid "channel.blue"
msgstr "青"

#. en: Alpha
msgid "channel.alpha"
msgstr "アルファ"

#. en: Only the {0} channel changes: white and black mean how much of it, and the other channels stay as they are.
msgid "hint.channel"
msgstr "{0}チャンネルだけが変わります。白と黒はその量を表し、ほかのチャンネルはそのまま残ります。"

#. en: Opened from {0}. Save writes over that file.
msgid "saved.opened"
msgstr "{0}から開きました。保存するとこのファイルに上書きされます。"

#. en: Replace the file?
msgid "dialog.replace.title"
msgstr "ファイルを上書きしますか？"

#. en: Saving writes over {0}. Every material that uses this file changes too, and Ctrl+Z cannot bring the old file back.
msgid "dialog.replace.message"
msgstr "{0}に上書き保存します。このファイルを使うすべてのマテリアルも変わり、Ctrl+Zでは元のファイルに戻せません。"

#. en: Replace
msgid "dialog.replace.ok"
msgstr "上書き"

#. en: Save as a new file
msgid "dialog.replace.new"
msgstr "新しいファイルとして保存"

#. en: It is set up as a colour texture now. Saving sets it up as a mask, so a material that shows it as a colour looks different.
msgid "dialog.replace.colour"
msgstr "現在はカラーテクスチャとして設定されています。保存するとマスクとして設定し直すため、色として表示しているマテリアルは見た目が変わります。"

#. en: Could not write {0}: {1}
msgid "status.savefailed"
msgstr "{0}に書き込めませんでした：{1}"

#. en: OK
msgid "dialog.ok"
msgstr "OK"

#. en: The painting tools are in the Mask Painter panel in the Scene view. Hidden? Press the ` key in the Scene view and turn it on.
msgid "hint.panel"
msgstr "塗るためのツールはシーンビューの Mask Painter パネルにあります。見えない場合は、シーンビューで ` キーを押してオンにしてください。"

#. en: Paint
msgid "field.blend"
msgstr "塗り方"

#. en: Whether a fill or stroke adds up toward white or sets one exact grey.
msgid "field.blend.tip"
msgstr "塗りつぶしやストロークを白へ重ねていくか、決まったグレーにするかを選びます。"

#. en: Add
msgid "blend.add"
msgstr "加算"

#. en: Each fill or stroke moves the mask toward the colour it paints by Strength.
msgid "blend.add.tip"
msgstr "塗るたびに、強さの分だけ塗る色へ近づけます。"

#. en: Replace
msgid "blend.replace"
msgstr "置き換え"

#. en: Each fill or stroke sets the mask to the Grey level, or to black.
msgid "blend.replace.tip"
msgstr "塗った場所を、グレーの値か黒そのものにします。"

#. en: Grey level
msgid "field.level"
msgstr "グレーの値"

#. en: The grey a fill or stroke paints, from 0 for black to 1 for white.
msgid "field.level.tip"
msgstr "塗りつぶしやストロークで塗るグレーで、0 が黒、1 が白です。"

#. en: Texture
msgid "section.texture"
msgstr "テクスチャ"

#. en: Painting
msgid "section.painting"
msgstr "ペイント中"

#. en: None (a new mask)
msgid "hint.texture.empty"
msgstr "なし（新しいマスク）"

#. en: New mask
msgid "row.newmask"
msgstr "新しいマスク"

#. en: What a new mask is before you paint on it.
msgid "row.newmask.tip"
msgstr "塗る前の新しいマスクの色です。"

#. en: The new mask starts black, so the effect shows nowhere until you paint.
msgid "start.black.tip"
msgstr "黒から始めます。塗るまでエフェクトはどこにも出ません。"

#. en: The new mask starts white, so the effect shows everywhere until you paint black.
msgid "start.white.tip"
msgstr "白から始めます。黒で塗るまでエフェクトは全体に出ます。"

#. en: Paint this texture
msgid "button.paintthis"
msgstr "このテクスチャを塗る"

#. en: Opens the texture with its size and every channel, ready to paint.
msgid "button.paintthis.tip"
msgstr "サイズと全チャンネルをそのままに開き、すぐ塗れる状態にします。"

#. en: Save writes back into this file after asking.
msgid "note.texture.writeback"
msgstr "保存するとこのファイルに上書きします。その前に確認があります。"

#. en: This file is only read. The first save asks where the mask goes.
msgid "note.texture.readonly"
msgstr "このファイルは読み込むだけです。最初の保存で保存先を選びます。"

#. en: No material in the open scenes uses this texture. Pick the mesh and material it is for.
msgid "note.texture.nouser"
msgstr "開いているシーンに、このテクスチャを使うマテリアルがありません。使う予定のメッシュとマテリアルを選んでください。"

#. en: Every channel
msgid "show.every"
msgstr "全チャンネル"

#. en: Overlay strength
msgid "field.overlay"
msgstr "重ねる濃さ"

#. en: How strongly the colours cover the model in the Scene view.
msgid "field.overlay.tip"
msgstr "シーンビューでモデルに重ねる色の濃さです。"

#. en: Paints
msgid "row.paints"
msgstr "塗る色"

#. en: The colour a click or stroke paints; Shift paints the other one and X swaps them.
msgid "row.paints.tip"
msgstr "クリックやドラッグで塗る色です。Shiftでもう一方の色になり、Xで入れ替えます。"

#. en: Paints white, or the Grey level with Replace.
msgid "paint.white.tip"
msgstr "白で塗ります。置き換えではグレーの値で塗ります。"

#. en: Paints black, so Shift paints white.
msgid "paint.black.tip"
msgstr "黒で塗ります。Shiftで白になります。"

#. en: BC4 (red only)
msgid "format.bc4"
msgstr "BC4（赤のみ）"

#. en: BC5 (red and green)
msgid "format.bc5"
msgstr "BC5（赤と緑）"

#. en: BC7
msgid "format.bc7"
msgstr "BC7"

#. en: Smooth
msgid "tool.smooth"
msgstr "ぼかし"

#. en: Drag on the model to soften the mask's edges (S).
msgid "tool.smooth.tip"
msgstr "モデル上をドラッグして、マスクの境目をぼかします（S）。"

#. en: Drag over an edge to soften it. Each pass softens a little more, and pieces never blur into each other.
msgid "hint.smooth"
msgstr "境目をドラッグするとぼかせます。なぞるたびに少しずつぼけ、別のパーツとは混ざりません。"

#. en: How much each pass of the Smooth brush softens the mask.
msgid "field.smooth.tip"
msgstr "ぼかしブラシで1回なぞったときのぼかし量です。"

#. en: Smooth mask
msgid "undo.smooth"
msgstr "マスクをぼかす"

#. en: Pen pressure
msgid "row.pen"
msgstr "筆圧"

#. en: With a drawing tablet, how hard you press changes these; a mouse always paints at full.
msgid "row.pen.tip"
msgstr "ペンタブレットでは、押す強さでこれらが変わります。マウスは常に最大で塗ります。"

#. en: Size
msgid "pen.size"
msgstr "サイズ"

#. en: Pressing lightly makes the brush smaller, down to a tenth of its size.
msgid "pen.size.tip"
msgstr "軽く押すとブラシが小さくなります。最小で10分の1です。"

#. en: Strength
msgid "pen.strength"
msgstr "強さ"

#. en: Pressing lightly paints or smooths less.
msgid "pen.strength.tip"
msgstr "軽く押すと、塗る量やぼかす量が減ります。"
